is_summary = is_sum,
arrow_lab  = c("Lower price", "Higher price"),
theme      = thm,
footnote   = if (any(df$kept_approx)) {
"Note: Post-trim counts marked with ≈ are approximations based on treated_prop × n_kept."
} else { NULL }
)
# --- Header rule (horizontal line under column names) ---
ncols <- length(visible_cols)  # here = 7
p <- add_border(
p,
part  = "header",                 # on the column header row
row   = 1,
col   = 1:ncols,                  # span all visible columns
where = "bottom",
gp    = gpar(lwd = 1.2, col = "grey40")
)
# -------- Save PDF --------
pdf(outfile_pdf, width = 13.5, height = 14)
plot(p)
dev.off()
message("Saved PDF: ", normalizePath(outfile_pdf))
# -------- Save PNG (ragg) --------
if (!requireNamespace("ragg", quietly = TRUE)) install.packages("ragg")
ragg::agg_png(outfile_png, width = 18, height = 7, units = "in", res = 900)
plot(p); dev.off()
message("Saved PNG: ", normalizePath(outfile_png))
# ---- NFT Forest Plot (Simple Forest Plot style; simple subgroup headers) ----
# Reads: nft_trait_v6_results_with_q.csv
# Output: nft_forest_simple_K1to4_top5.pdf + .png
# Requires: forestploter, grid, scales (and ragg for PNG)
suppressPackageStartupMessages({
library(forestploter)
library(grid)
library(scales)
})
# ---------------- Config ----------------
infile      <- "nft_trait_v6_results_with_q.csv"
outfile_pdf <- "nft_forest_simple_K1to4_top5.pdf"
outfile_png <- "nft_forest_simple_K1to4_top5.png"
ks_to_plot  <- 1:4
top_n       <- 5
ci_spaces   <- 80         # width of CI lane (spaces)
wrap_width  <- 70         # wrap width for combo labels
use_shorten <- TRUE       # abbreviate long trait family prefixes
base_font   <- 12         # forest_theme(base_size)
# ---------------- Helpers ----------------
fmt_int  <- function(x) format(round(as.numeric(x)), big.mark = ",", trim = TRUE)
fmt_pct1 <- function(x) sprintf("%.1f", as.numeric(x))
fmt_q3   <- function(x) sprintf("%.3f", as.numeric(x))
to_pct   <- function(z) 100 * (exp(as.numeric(z)) - 1)
shorten_combo <- function(s) {
s <- gsub("Background_", "BG:", s)
s <- gsub("Earring_",   "Ear:", s)
s <- gsub("Clothes_",   "Cl:",  s)
s <- gsub("Eyes_",      "Eyes:", s)
s <- gsub("Fur_",       "Fur:", s)
s <- gsub("Hat_",       "Hat:", s)
s <- gsub("Mouth_",     "Mouth:", s)
s <- gsub("\\.", "·", s)
s
}
wrap_combo_vec <- function(x, width = 30) {
vapply(x, function(s) {
if (is.na(s) || s == "") return("")
s <- gsub("\\+", " + ", s)
s <- gsub("_",  "_ ",  s)
s <- gsub("\\.", "·",  s)
paste(strwrap(s, width = width), collapse = "\n")
}, character(1))
}
warn_once <- local({
warned <- FALSE
function(msg) { if (!warned) { message(msg); warned <<- TRUE } }
})
# ---------------- Load ----------------
df <- read.csv(infile, stringsAsFactors = FALSE, check.names = FALSE)
need <- c("k","traits_combination",
"treated_count","treated_prop",
"n_kept","kept_pct","overlap_alpha",
"ATE","CI_lower","CI_upper","StdErr","q_value_bh")
miss <- setdiff(need, names(df))
if (length(miss)) stop("Missing columns in input: ", paste(miss, collapse = ", "))
# Optional columns
has_control_count <- "control_count" %in% names(df)
has_treated_kept  <- "treated_kept"  %in% names(df)
has_control_kept  <- "control_kept"  %in% names(df)
# Pre-trim control count if absent
if (!has_control_count) {
N_all <- with(df, ifelse(treated_prop > 0, treated_count / treated_prop, NA))
df$control_count <- N_all - df$treated_count
}
# Prefer percent columns from file; fallback to compute
have_pct_cols <- all(c("ATE_pct","CI_lower_pct","CI_upper_pct") %in% names(df))
if (have_pct_cols) {
df$ATE_pct     <- as.numeric(df$ATE_pct)
df$CI_low_pct  <- as.numeric(df$CI_lower_pct)
df$CI_up_pct   <- as.numeric(df$CI_upper_pct)
if (any(!is.finite(df$ATE_pct)) || any(!is.finite(df$CI_low_pct)) || any(!is.finite(df$CI_up_pct))) {
df$ATE_pct    <- to_pct(df$ATE)
df$CI_low_pct <- to_pct(df$CI_lower)
df$CI_up_pct  <- to_pct(df$CI_upper)
}
} else {
df$ATE_pct    <- to_pct(df$ATE)
df$CI_low_pct <- to_pct(df$CI_lower)
df$CI_up_pct  <- to_pct(df$CI_upper)
}
# Post-trim arm counts: exact or approximated if missing
if (!has_treated_kept || !has_control_kept) {
warn_once("treated_kept / control_kept not found; approximating via treated_prop × n_kept.")
df$treated_kept <- df$treated_prop * df$n_kept
df$control_kept <- (1 - df$treated_prop) * df$n_kept
df$kept_approx  <- TRUE
} else {
df$treated_kept <- as.numeric(df$treated_kept)
df$control_kept <- as.numeric(df$control_kept)
df$kept_approx  <- FALSE
}
# ---------------- Rank: q asc -> |ATE_pct| desc -> kept_pct desc ----------------
df$abs_ATE_pct <- abs(df$ATE_pct)
# make sure kept_pct is numeric
df$kept_pct <- as.numeric(df$kept_pct)
# Top-N per K with specified ordering
topN <- do.call(rbind, lapply(ks_to_plot, function(kv) {
sub <- df[df$k == kv, , drop = FALSE]
if (!nrow(sub)) return(sub)
sub <- sub[order(sub$q_value_bh, -sub$abs_ATE_pct, -sub$kept_pct), , drop = FALSE]
sub[seq_len(min(nrow(sub), top_n)), , drop = FALSE]
}))
if (!nrow(topN)) stop("No rows selected for K in {", paste(ks_to_plot, collapse = ","), "}.")
# ---------------- Build Simple-Forest table ----------------
make_rows_for_k <- function(dat_k, k_val) {
if (!nrow(dat_k)) return(NULL)
# Header row (no CI; will be bold via is_summary)
head_row <- data.frame(
Subgroup        = paste0("K = ", k_val),
`Pre (C/T)`     = "",
`Post (C/T)`    = "",
`Kept (n %)`    = "",
` `             = paste(rep(" ", ci_spaces), collapse = " "),
`ATE% (95% CI)` = "",
`q`             = "",
est = NA_real_, low = NA_real_, hi = NA_real_, se = NA_real_,
stringsAsFactors = FALSE, check.names = FALSE
)
# Labels
labs <- dat_k$traits_combination
if (isTRUE(use_shorten)) labs <- shorten_combo(labs)
labs <- wrap_combo_vec(labs, width = wrap_width)
combo <- paste0("   ", labs)  # indent items under subgroup
# Columns
pre_ct  <- paste0(fmt_int(dat_k$control_count), " / ", fmt_int(dat_k$treated_count))
post_ct <- paste0(fmt_int(dat_k$control_kept),  " / ", fmt_int(dat_k$treated_kept))
# If you want to mark approximations, add ≈ here (currently suppressed on purpose)
kept_info <- paste0(fmt_int(dat_k$n_kept), " (", fmt_pct1(dat_k$kept_pct), "%)")
eff_txt   <- paste0(fmt_pct1(dat_k$ATE_pct), "% [",
fmt_pct1(dat_k$CI_low_pct), ", ",
fmt_pct1(dat_k$CI_up_pct),  "%]")
q_txt     <- fmt_q3(dat_k$q_value_bh)
# Box sizes: hybrid precision/support
w1 <- 1 / pmax(1e-9, dat_k$StdErr)                                # precision (log scale se)
w2 <- sqrt(pmax(0, pmin(dat_k$treated_kept, dat_k$control_kept)))  # limiting arm support
clip01 <- function(x) {
q <- stats::quantile(x, c(.15, .85), na.rm = TRUE)
x <- pmin(pmax(x, q[1]), q[2])
scales::rescale(x, to = c(0, 1))
}
u1 <- clip01(w1); u2 <- clip01(w2)
se <- scales::rescale(0.6*u1 + 0.4*u2, to = c(0.24, 0.38))
det <- data.frame(
Subgroup        = combo,
`Pre (C/T)`     = pre_ct,
`Post (C/T)`    = post_ct,
`Kept (n %)`    = kept_info,
` `             = paste(rep(" ", ci_spaces), collapse = " "),
`ATE% (95% CI)` = eff_txt,
`q`             = q_txt,
est = dat_k$ATE_pct, low = dat_k$CI_low_pct, hi = dat_k$CI_up_pct, se = se,
stringsAsFactors = FALSE, check.names = FALSE
)
rbind(head_row, det)
}
plot_table <- do.call(rbind, lapply(ks_to_plot, function(kv) {
make_rows_for_k(topN[topN$k == kv, , drop = FALSE], kv)
}))
# Clean text NAs
txt_cols <- c("Subgroup","Pre (C/T)","Post (C/T)","Kept (n %)"," ","ATE% (95% CI)","q")
for (cc in txt_cols) if (cc %in% names(plot_table)) plot_table[[cc]][is.na(plot_table[[cc]])] <- ""
# Shared axis for % effects
rng  <- range(c(plot_table$low, plot_table$hi), na.rm = TRUE)
pad  <- max(1, 0.10 * diff(rng))
xlim <- c(rng[1] - pad, rng[2] + pad)
ticks<- pretty(xlim, n = 5)
# Theme: remove zebra stripes + keep alignment; bigger base font
thm <- forest_theme(
base_size   = base_font,
ci_pch      = 15,
ci_col      = "#4575b4",
ci_fill     = "#4575b4",
ci_alpha    = 0.9,
ci_lwd      = 1.1,
ci_Theight  = 0.18,
refline_gp  = gpar(lwd = 1, lty = "dashed", col = "grey40"),
core = list(
fg_params = list(
hjust      = c(1, 1, 1, 1, 1, 1, 1),
x          = c(1, 1, 1, 1, 1, 1, 1),
lineheight = rep(1.05, 7)
),
bg_params = list(fill = "white", col = NA)  # no zebra stripes
),
colhead = list(
fg_params = list(
hjust      = c(0.5, .5, .5, .5, .5, .5, .5),
x          = c(0.5, .6, .6, .6, .6, .6, .6),
fontface   = 2,
lineheight = rep(1.05, 7)
),
bg_params = list(fill = "white", col = NA)
),
summary_col  = "#333333",
summary_fill = "#333333"
)
# Flag subgroup rows (K = ...) as summary so they render bold
is_sum <- is.na(plot_table$est)
# Visible columns in the table
visible_cols <- c("Subgroup","Pre (C/T)","Post (C/T)","Kept (n %)"," ","ATE% (95% CI)","q")
# Draw forest
p <- forest(
plot_table[, visible_cols],
est        = plot_table$est,
lower      = plot_table$low,
upper      = plot_table$hi,
sizes      = plot_table$se,
ci_column  = 5,   # the blank " " column
ref_line   = 0,
xlim       = xlim,
ticks_at   = ticks,
is_summary = is_sum,   # bold K rows
arrow_lab  = c("Lower price", "Higher price"),
theme      = thm,
footnote   = if (any(df$kept_approx)) {
"Note: Post-trim counts may be approximations based on treated_prop × n_kept."
} else { NULL }
)
# --- Header rule (horizontal line under column names) ---
ncols <- length(visible_cols)
p <- add_border(
p,
part  = "header",
row   = 1,
col   = 1:ncols,
where = "bottom",
gp    = gpar(lwd = 1.2, col = "grey40")
)
# -------- Save PDF --------
pdf(outfile_pdf, width = 13.5, height = 14)
plot(p)
dev.off()
message("Saved PDF: ", normalizePath(outfile_pdf))
# -------- Save PNG (high-res via ragg) --------
if (!requireNamespace("ragg", quietly = TRUE)) install.packages("ragg")
ragg::agg_png(outfile_png, width = 18, height = 7, units = "in", res = 900)
plot(p); dev.off()
message("Saved PNG: ", normalizePath(outfile_png))
# ---- NFT Forest Plot (Simple Forest Plot style; simple subgroup headers) ----
# Reads: nft_trait_v6_results_with_q.csv
# Output: nft_forest_simple_K1to4_top5.pdf + .png
# Requires: forestploter, grid, scales (and ragg for PNG)
suppressPackageStartupMessages({
library(forestploter)
library(grid)
library(scales)
})
# ---------------- Config ----------------
infile      <- "nft_trait_v6_results_with_q.csv"
outfile_pdf <- "nft_forest_simple_K1to4_top5.pdf"
outfile_png <- "nft_forest_simple_K1to4_top5.png"
ks_to_plot  <- 1:4
top_n       <- 5
ci_spaces   <- 80         # width of CI lane (spaces)
wrap_width  <- 70         # wrap width for combo labels
use_shorten <- TRUE       # abbreviate long trait family prefixes
base_font   <- 12         # forest_theme(base_size)
keep_min    <- 60         # FILTER: require kept_pct >= 60
# ---------------- Helpers ----------------
fmt_int  <- function(x) format(round(as.numeric(x)), big.mark = ",", trim = TRUE)
fmt_pct1 <- function(x) sprintf("%.1f", as.numeric(x))
fmt_q3   <- function(x) sprintf("%.3f", as.numeric(x))
to_pct   <- function(z) 100 * (exp(as.numeric(z)) - 1)
shorten_combo <- function(s) {
s <- gsub("Background_", "BG:", s)
s <- gsub("Earring_",   "Ear:", s)
s <- gsub("Clothes_",   "Cl:",  s)
s <- gsub("Eyes_",      "Eyes:", s)
s <- gsub("Fur_",       "Fur:", s)
s <- gsub("Hat_",       "Hat:", s)
s <- gsub("Mouth_",     "Mouth:", s)
s <- gsub("\\.", "·", s)
s
}
wrap_combo_vec <- function(x, width = 30) {
vapply(x, function(s) {
if (is.na(s) || s == "") return("")
s <- gsub("\\+", " + ", s)
s <- gsub("_",  "_ ",  s)
s <- gsub("\\.", "·",  s)
paste(strwrap(s, width = width), collapse = "\n")
}, character(1))
}
warn_once <- local({
warned <- FALSE
function(msg) { if (!warned) { message(msg); warned <<- TRUE } }
})
# ---------------- Load ----------------
df <- read.csv(infile, stringsAsFactors = FALSE, check.names = FALSE)
# Columns present in your file:
# traits_combination k treated_count control_count treated_ok control_ok
# treated_kept control_kept treated_prop control_prop treated_prop_kept control_prop_kept
# ATE CI_lower CI_upper StdErr p_value ATE_pct CI_lower_pct CI_upper_pct
# overlap_alpha target_sample n_total n_kept kept_pct q_value_bh
need <- c("k","traits_combination",
"treated_count","control_count","treated_prop",
"ATE","CI_lower","CI_upper","StdErr","q_value_bh",
"n_kept","kept_pct")
miss <- setdiff(need, names(df))
if (length(miss)) stop("Missing columns in input: ", paste(miss, collapse = ", "))
# Optional post-trim counts
has_treated_kept <- "treated_kept" %in% names(df)
has_control_kept <- "control_kept" %in% names(df)
# Use % effect columns from file; fallback if absent/bad
have_pct_cols <- all(c("ATE_pct","CI_lower_pct","CI_upper_pct") %in% names(df))
if (have_pct_cols) {
df$ATE_pct     <- as.numeric(df$ATE_pct)
df$CI_lower_pct<- as.numeric(df$CI_lower_pct)
df$CI_upper_pct<- as.numeric(df$CI_upper_pct)
if (any(!is.finite(df$ATE_pct)) || any(!is.finite(df$CI_lower_pct)) || any(!is.finite(df$CI_upper_pct))) {
df$ATE_pct      <- to_pct(df$ATE)
df$CI_lower_pct <- to_pct(df$CI_lower)
df$CI_upper_pct <- to_pct(df$CI_upper)
}
} else {
df$ATE_pct      <- to_pct(df$ATE)
df$CI_lower_pct <- to_pct(df$CI_lower)
df$CI_upper_pct <- to_pct(df$CI_upper)
}
# Ensure numerics
df$kept_pct <- as.numeric(df$kept_pct)
df$n_kept   <- as.numeric(df$n_kept)
# Post-trim counts: use provided, else approximate
if (!has_treated_kept || !has_control_kept) {
warn_once("treated_kept / control_kept not found; approximating via treated_prop × n_kept.")
df$treated_kept <- df$treated_prop * df$n_kept
df$control_kept <- (1 - df$treated_prop) * df$n_kept
df$kept_approx  <- TRUE
} else {
df$treated_kept <- as.numeric(df$treated_kept)
df$control_kept <- as.numeric(df$control_kept)
df$kept_approx  <- FALSE
}
# ---------------- Filter first, then rank ----------------
# Filter by kept_pct >= keep_min (drop NAs)
df_f <- df[is.finite(df$kept_pct) & df$kept_pct >= keep_min, , drop = FALSE]
if (!nrow(df_f)) stop("No rows pass kept_pct >= ", keep_min, "%. Loosen the filter or inspect data.")
# Ranking keys
df_f$abs_ATE_pct <- abs(df_f$ATE_pct)
# Top-N per K after filter with order: q asc -> |ATE_pct| desc -> kept_pct desc
topN <- do.call(rbind, lapply(ks_to_plot, function(kv) {
sub <- df_f[df_f$k == kv, , drop = FALSE]
if (!nrow(sub)) {
# still return a header-only block later
return(sub)
}
sub <- sub[order(sub$q_value_bh, -sub$abs_ATE_pct, -sub$kept_pct), , drop = FALSE]
sub[seq_len(min(nrow(sub), top_n)), , drop = FALSE]
}))
# ---------------- Build Simple-Forest table ----------------
make_rows_for_k <- function(dat_k, k_val) {
# header row (no CI; will render bold via is_summary)
head_row <- data.frame(
Subgroup        = paste0("K = ", k_val),
`Pre (C/T)`     = "",
`Post (C/T)`    = "",
`Kept (n %)`    = "",
` `             = paste(rep(" ", ci_spaces), collapse = " "),
`ATE% (95% CI)` = "",
`q`             = "",
est = NA_real_, low = NA_real_, hi = NA_real_, se = NA_real_,
stringsAsFactors = FALSE, check.names = FALSE
)
if (!nrow(dat_k)) return(head_row)
labs <- dat_k$traits_combination
if (isTRUE(use_shorten)) labs <- shorten_combo(labs)
labs <- wrap_combo_vec(labs, width = wrap_width)
combo <- paste0("   ", labs)  # indent under subgroup
pre_ct  <- paste0(fmt_int(dat_k$control_count), " / ", fmt_int(dat_k$treated_count))
post_ct <- paste0(fmt_int(dat_k$control_kept),  " / ", fmt_int(dat_k$treated_kept))
kept_info <- paste0(fmt_int(dat_k$n_kept), " (", fmt_pct1(dat_k$kept_pct), "%)")
eff_txt   <- paste0(fmt_pct1(dat_k$ATE_pct), "% [",
fmt_pct1(dat_k$CI_lower_pct), ", ",
fmt_pct1(dat_k$CI_upper_pct), "%]")
q_txt     <- fmt_q3(dat_k$q_value_bh)
# Hybrid box size (precision + support)
w1 <- 1 / pmax(1e-9, dat_k$StdErr)
w2 <- sqrt(pmax(0, pmin(dat_k$treated_kept, dat_k$control_kept)))
clip01 <- function(x) {
q <- stats::quantile(x, c(.15, .85), na.rm = TRUE)
x <- pmin(pmax(x, q[1]), q[2]); scales::rescale(x, to = c(0, 1))
}
u1 <- clip01(w1); u2 <- clip01(w2)
se <- scales::rescale(0.6*u1 + 0.4*u2, to = c(0.24, 0.38))
det <- data.frame(
Subgroup        = combo,
`Pre (C/T)`     = pre_ct,
`Post (C/T)`    = post_ct,
`Kept (n %)`    = kept_info,
` `             = paste(rep(" ", ci_spaces), collapse = " "),
`ATE% (95% CI)` = eff_txt,
`q`             = q_txt,
est = dat_k$ATE_pct, low = dat_k$CI_lower_pct, hi = dat_k$CI_upper_pct, se = se,
stringsAsFactors = FALSE, check.names = FALSE
)
rbind(head_row, det)
}
plot_table <- do.call(rbind, lapply(ks_to_plot, function(kv) {
make_rows_for_k(topN[topN$k == kv, , drop = FALSE], kv)
}))
# Clean text NAs
txt_cols <- c("Subgroup","Pre (C/T)","Post (C/T)","Kept (n %)"," ","ATE% (95% CI)","q")
for (cc in txt_cols) if (cc %in% names(plot_table)) plot_table[[cc]][is.na(plot_table[[cc]])] <- ""
# ----- Axis: build breaks first, then set xlim to the breaks' range (prevents ticks_at/xlim mismatch)
rng_vals <- range(c(plot_table$low, plot_table$hi), na.rm = TRUE)
if (!all(is.finite(rng_vals))) {
rng_vals <- c(-50, 50)  # fallback in % scale if no detail rows exist
}
breaks <- pretty(rng_vals, n = 5)
xlim   <- range(breaks)
ticks  <- breaks   # guaranteed inside xlim
# ---------------- Theme (no zebra stripes, consistent right alignment)
thm <- forest_theme(
base_size   = base_font,
ci_pch      = 15,
ci_col      = "#4575b4",
ci_fill     = "#4575b4",
ci_alpha    = 0.9,
ci_lwd      = 1.1,
ci_Theight  = 0.18,
refline_gp  = gpar(lwd = 1, lty = "dashed", col = "grey40"),
core = list(
fg_params = list(
# Right-align all columns (as you preferred previously)
hjust      = c(1, 1, 1, 1, 1, 1, 1),
x          = c(1, 1, 1, 1, 1, 1, 1),
lineheight = rep(1.05, 7)
),
bg_params = list(fill = "white", col = NA)  # no zebra stripes
),
colhead = list(
fg_params = list(
hjust      = c(0.5, .5, .5, .5, .5, .5, .5),
x          = c(0.5, .6, .6, .6, .6, .6, .6),
fontface   = 2,
lineheight = rep(1.05, 7)
),
bg_params = list(fill = "white", col = NA)
),
summary_col  = "#333333",
summary_fill = "#333333"
)
# Bold subgroup rows (K = ...)
is_sum <- is.na(plot_table$est)
# Visible columns in the table
visible_cols <- c("Subgroup","Pre (C/T)","Post (C/T)","Kept (n %)"," ","ATE% (95% CI)","q")
# Draw forest
p <- forest(
plot_table[, visible_cols],
est        = plot_table$est,
lower      = plot_table$low,
upper      = plot_table$hi,
sizes      = plot_table$se,
ci_column  = 5,   # the blank " " column
ref_line   = 0,
xlim       = xlim,
ticks_at   = ticks,
is_summary = is_sum,   # bold K rows
arrow_lab  = c("Lower price", "Higher price"),
theme      = thm,
footnote   = if (any(df$kept_approx)) {
"Note: Post-trim counts may be approximations based on treated_prop × n_kept."
} else { NULL }
)
# --- Header rule (horizontal line under column names) ---
ncols <- length(visible_cols)
p <- add_border(
p,
part  = "header",
row   = 1,
col   = 1:ncols,
where = "bottom",
gp    = gpar(lwd = 1.2, col = "grey40")
)
# -------- Save PDF --------
pdf(outfile_pdf, width = 13.5, height = 14)
plot(p)
dev.off()
message("Saved PDF: ", normalizePath(outfile_pdf))
# -------- Save PNG (high-res via ragg) --------
if (!requireNamespace("ragg", quietly = TRUE)) install.packages("ragg")
ragg::agg_png(outfile_png, width = 18, height = 7, units = "in", res = 900)
plot(p); dev.off()
message("Saved PNG: ", normalizePath(outfile_png))
